{
  "name": "frontend",
  "version": "1.0.0",
  "description": "Parte Frontend do sistema MyProjects",
  "main": "src/App.ts",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "setup": "node scripts/setup.js",
    "test": "ng test",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "test:ci": "node scripts/test-ci.js",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"*.{ts,json,md}\" \"e2e/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"*.{ts,json,md}\" \"e2e/**/*.ts\" \"scripts/*.mjs\""
  },
  "type": "module",
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/inter": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.1",
    "@ngx-env/builder": "^22.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
